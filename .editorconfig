# Стиль и анализаторы XEngine. Требования — 17.1 и 17.5.
#
# root = true прекращает поиск файла выше корня репозитория: настройки
# не должны зависеть от настроек каталога, в котором лежит копия.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.cs]
# --- Порядок using (17.1: System первым, затем чужие, затем свои) ---
dotnet_separate_import_directive_groups = true
dotnet_sort_system_directives_first = true

# --- Пространства имён: файловые, без отступов (17.1) ---
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning

# --- Языковые предпочтения ---
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = false:none
csharp_style_prefer_switch_expression = true:suggestion
csharp_prefer_pattern_matching_over_as_with_null_check = true:warning
csharp_prefer_not_pattern = true:suggestion

# --- Именование (17.1) ---
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case

dotnet_naming_rule.types_and_interfaces_pascal_case.severity = warning
dotnet_naming_rule.types_and_interfaces_pascal_case.symbols = types_and_interfaces
dotnet_naming_rule.types_and_interfaces_pascal_case.style = pascal_case

dotnet_naming_rule.interfaces_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_prefixed_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed_with_i.style = prefixed_i

dotnet_naming_rule.constants_pascal_case.severity = warning
dotnet_naming_rule.constants_pascal_case.symbols = constants
dotnet_naming_rule.constants_pascal_case.style = pascal_case

dotnet_naming_rule.parameters_camel_case.severity = warning
dotnet_naming_rule.parameters_camel_case.symbols = parameters
dotnet_naming_rule.parameters_camel_case.style = camel_case

dotnet_naming_rule.locals_camel_case.severity = warning
dotnet_naming_rule.locals_camel_case.symbols = locals
dotnet_naming_rule.locals_camel_case.style = camel_case

# --- Требования к участникам кода ---
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
csharp_style_prefer_compound_assignment = true:suggestion
dotnet_style_object_initializer = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# --- Диагностика: неиспользуемый код ---
# suggestion, а не warning: анализатор IDE0005 умеет работать при сборке
# только вместе с GenerateDocumentationFile, а у тестовых проектов он
# выключен. Правило остаётся видимым в редакторе для всего решения.
dotnet_diagnostic.IDE0005.severity = suggestion

# --- Анализаторы: перечень из 17.5 ---
# Состав задан списком, а не уровнем анализа: правила должны быть видны
# в этом файле, иначе их состав невозможно проверить ревью.
dotnet_diagnostic.CA1031.severity = warning   # не ловить Exception без логирования
dotnet_diagnostic.CA1062.severity = warning   # проверка null в публичных методах
dotnet_diagnostic.CA1819.severity = warning   # массивы отдавать как ReadOnlySpan
dotnet_diagnostic.CA1848.severity = warning   # логирование через LoggerMessage
dotnet_diagnostic.CA2007.severity = warning   # ConfigureAwait
dotnet_diagnostic.CA2227.severity = warning   # коллекции в параметрах

# --- Анализаторы явно отключённые ---
# StyleCop конфликтует с соглашениями проекта: он требует порядка using и
# документации по своим правилам, а документация ведётся вручную (17.5).
dotnet_diagnostic.StyleCop.Analyzers.StyleCopAnalyzers.severity = none
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1000.severity = none
dotnet_diagnostic.SA1001.severity = none
dotnet_diagnostic.SA1002.severity = none
dotnet_diagnostic.SA1003.severity = none
dotnet_diagnostic.SA1005.severity = none
dotnet_diagnostic.SA1008.severity = none
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1010.severity = none
dotnet_diagnostic.SA1011.severity = none
dotnet_diagnostic.SA1012.severity = none
dotnet_diagnostic.SA1013.severity = none
dotnet_diagnostic.SA1014.severity = none
dotnet_diagnostic.SA1015.severity = none
dotnet_diagnostic.SA1016.severity = none
dotnet_diagnostic.SA1017.severity = none
dotnet_diagnostic.SA1018.severity = none
dotnet_diagnostic.SA1019.severity = none
dotnet_diagnostic.SA1020.severity = none
dotnet_diagnostic.SA1021.severity = none
dotnet_diagnostic.SA1022.severity = none
dotnet_diagnostic.SA1024.severity = none
dotnet_diagnostic.SA1025.severity = none
dotnet_diagnostic.SA1026.severity = none
dotnet_diagnostic.SA1027.severity = none
dotnet_diagnostic.SA1028.severity = none
dotnet_diagnostic.SA1029.severity = none
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1200.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1310.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none

[*.md]
# Длинные строки в тексте и таблицах переносить нельзя.
trim_trailing_whitespace = false