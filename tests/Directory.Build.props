<Project>

  <!--
    Настройки тестовых проектов (все, что лежит в tests/).

    Импортирует общий файл решения и добавляет только то, что тестам не
    нужно: XML-документация публичного API обязательна для движка (17.1),
    но не для тестовых классов. Версии пакетов вынесены сюда, чтобы десять
    будущих тестовых проектов не расходились между собой.
  -->

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Выбор математического backend должен доходить и до тестов.

    Тесты условно компилируются: часть проверок Assert.Equal работает только в
    детерминированном варианте, часть — только в быстром, и без этого
    определения тесты проверяли бы не тот вариант, который собран. Свойство
    передаётся из командной строки и в библиотеку, и сюда:
        dotnet test tests/XEngine.Mathematics.Tests -p:MathBackend=Deterministic
  -->

  <PropertyGroup>
    <MathBackend Condition="'$(MathBackend)' == ''">Fast</MathBackend>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Deterministic'">
    <MathBackend>Deterministic</MathBackend>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MathBackend)' == 'Deterministic'">
    <DefineConstants>$(DefineConstants);XENGINE_DETERMINISTIC_MATH</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>