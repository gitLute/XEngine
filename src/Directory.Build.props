<Project>

  <!--
    Настройки проектов движка (всё, что лежит в src/).

    Импортирует общий файл решения и добавляет одно: версии внешних пакетов.
    Окно, ввод и OpenGL собираются на Silk.NET, и его типы пересекают границу
    проектов, поэтому версия обязана быть одна на все проекты: две разные
    версии в разных сборках означают, что тип, который считали общим, таковым
    перестал быть, и ошибка проявится как несовместимость при передаче, а не
    при сборке.
  -->

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <SilkNetVersion>2.23.0</SilkNetVersion>
  </PropertyGroup>

</Project>